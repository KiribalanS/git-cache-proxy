# Copy to .env (never commit .env -- add it to .gitignore) and fill in a
# dedicated, read-only ("Code: Read" scope only, if your upstream supports
# scoping) credential for this cache to authenticate to your upstream git
# server on behalf of every client. Do not reuse a personal credential that
# carries write scope -- this lives on a shared cache instance.
#
# Both required together, or leave both blank to run anonymous (only works
# against a fully public upstream).
GIT_CACHE_UPSTREAM_USERNAME=
GIT_CACHE_UPSTREAM_PAT=

# How often (seconds) the warm/fetch path is allowed to repack with fresh
# bitmaps. Default 600 (10 minutes). The very first clone of a repo always
# repacks once, unconditionally, regardless of this setting.
# GIT_CACHE_REPACK_DEBOUNCE_S=600

# Set to "false" to disable the pack-byte cache for git-upload-pack
# entirely (falls back to recomputing the pack fresh on every request).
# GIT_CACHE_PACK_CACHE_ENABLED=true
