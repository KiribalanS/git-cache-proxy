# These files run unmodified inside a Linux/Alpine container. A CRLF
# checkout (e.g. Windows core.autocrlf=true) breaks the shebang lines and
# every here-doc/heredoc-sensitive parsing in them, so force LF regardless
# of the checking-out machine's line-ending settings.
*.sh    text eol=lf
Dockerfile text eol=lf
*.conf  text eol=lf
docker-compose.yml text eol=lf

# .env is parsed line-by-line by Docker's env_file directive, which does not
# strip \r -- a CRLF checkout here would silently append a trailing \r onto
# the PAT/username values themselves, corrupting the credential without any
# visible error.
.env         text eol=lf
.env.example text eol=lf
